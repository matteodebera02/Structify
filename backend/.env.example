# Database
DATABASE_URL=postgresql://user:password@localhost:5432/structify

# JWT
SECRET_KEY=your-super-secret-jwt-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=540

# Groq AI — get a free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your-groq-api-key-here

# Resend email — get a free key at https://resend.com
# Only needed for forgot-password emails
RESEND_API_KEY=re_your-resend-api-key-here
FROM_EMAIL=onboarding@resend.dev

# CORS — frontend origin
FRONTEND_URL=http://localhost:5173
